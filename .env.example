# ============================================================
# [필수] 서버 전용 환경 변수 (Vercel Settings > Environment Variables)
# 주의: 클라이언트(VITE_*)로 절대 노출하지 마세요.
# ============================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ============================================================
# [선택] 서버/백엔드 프록시 설정 (process.env)
# ============================================================
# 배포된 앱의 기본 URL (Vercel 또는 AI Studio 런타임에서 자동 주입 가능)
APP_URL="MY_APP_URL"

# CORS 허용 도메인 (미설정 시 '*' 허용, 운영 시 'https://your-domain.vercel.app' 권장)
ALLOWED_ORIGIN="*"

# Open-Meteo API 엔드포인트 및 선택적 상용 API 키
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"
# OPEN_METEO_API_KEY=""

# ============================================================
# [선택] 프론트엔드 환경 변수 (import.meta.env.VITE_*)
# ============================================================
# 동일 도메인(/api/*) 배포 시 비워 두세요.
# API 서버를 별도 도메인에 분리 배포할 경우에만 URL을 입력하세요. (예: https://api.example.com)
VITE_API_BASE_URL=""
